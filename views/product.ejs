<p style="margin-top:18px;"><a href="/" class="muted">← Back to browse</a></p>

<div class="detail">
  <div>
    <% if (images.length) { %>
      <div style="position:relative;">
        <img class="main-img" id="mainImg" src="<%= images[0].url %>" alt="<%= product.title %>">
        <% if (product.blur_previews) { %>
          <span style="position:absolute;bottom:10px;left:10px;background:rgba(43,36,48,.82);color:#fff;padding:6px 12px;border-radius:999px;font-size:.8rem;font-weight:600;">🔒 Preview — full quality after purchase</span>
        <% } %>
      </div>
      <% if (images.length > 1) { %>
        <div class="thumbs">
          <% images.forEach(function(im){ %>
            <img src="<%= im.url %>" onclick="document.getElementById('mainImg').src=this.src">
          <% }); %>
        </div>
      <% } %>
    <% } else { %>
      <div class="main-img" style="display:flex;align-items:center;justify-content:center;color:var(--muted);">No photo</div>
    <% } %>
  </div>

  <div>
    <span class="tag"><%= categoryLabels[product.category] %></span>
    <h1 style="margin-top:8px;"><%= product.title %></h1>
    <div class="price-big"><%= money(product.price_cents) %></div>
    <p class="muted">Sold by <a href="/store/<%= product.seller_handle %>"><strong><%= product.seller_name %></strong></a></p>

    <% if (product.seller_locked) { %>
      <p class="muted">This item is temporarily unavailable.</p>
    <% } else if (product.status !== 'active') { %>
      <p><span class="badge <%= product.status %>"><%= product.status %></span> — not available for purchase.</p>
    <% } else if (user && user.id === product.seller_id) { %>
      <p class="muted">This is your listing. <a href="/seller/<%= product.id %>/edit">Edit it</a>.</p>
    <% } %>

    <% if (!user || user.id !== product.seller_id) { %>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;">
        <% if (!product.seller_locked && product.status === 'active') { %>
          <a class="btn" href="/product/<%= product.id %>/checkout">Buy — <%= money(product.price_cents) %></a>
        <% } %>
        <a class="btn secondary" href="/store/<%= product.seller_handle %>#chat">💬 Message seller</a>
      </div>
    <% } %>

    <%- include('partials/share', {
      shareUrl: absUrl('/product/' + product.id),
      shareTitle: product.title + ' — ' + money(product.price_cents),
      label: (user && user.id === product.seller_id) ? 'Share this listing:' : 'Share:'
    }) %>

    <% if (product.description) { %>
      <div class="section">
        <h2>Description</h2>
        <p style="white-space:pre-wrap;"><%= product.description %></p>
      </div>
    <% } %>
    <% if (product.seller_bio) { %>
      <div class="section">
        <h2>About the seller</h2>
        <p class="muted" style="white-space:pre-wrap;"><%= product.seller_bio %></p>
      </div>
    <% } %>
  </div>
</div>
