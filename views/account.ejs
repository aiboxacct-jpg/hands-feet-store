<div class="form-card">
  <h1>My account</h1>
  <p class="page-sub"><%= user.email %> · <span class="badge active"><%= user.role %></span></p>
  <% if (error) { %><div class="form-error"><%= error %></div><% } %>

  <% if (user.role === 'seller' || user.role === 'admin') { %>
    <% var storeUrl = absUrl('/store/' + (user.handle || user.id)); %>
    <label>Your store link <span class="muted" style="font-weight:400;">(share this anywhere)</span></label>
    <div class="share-link">
      <input type="text" readonly value="<%= storeUrl %>" onclick="this.select()">
      <button type="button" class="btn small share-copy" data-url="<%= storeUrl %>">🔗 Copy</button>
      <a class="btn small secondary" href="/store/<%= user.handle || user.id %>" target="_blank" rel="noopener">View</a>
    </div>
  <% } %>

  <form action="/account" method="post">
    <label for="display_name">Display name</label>
    <input type="text" id="display_name" name="display_name" value="<%= user.display_name %>" required>

    <label for="bio">Bio (shown on your listings)</label>
    <textarea id="bio" name="bio"><%= user.bio || '' %></textarea>

    <% if (user.role === 'seller' || user.role === 'admin') { %>
      <label for="handle">Store URL name</label>
      <div style="display:flex;align-items:center;gap:6px;">
        <span class="muted" style="white-space:nowrap;">/store/</span>
        <input type="text" id="handle" name="handle" value="<%= user.handle || '' %>" placeholder="your-store-name" style="flex:1;">
      </div>
      <p class="hint">Letters, numbers and dashes. This is your shareable store link.</p>
    <% } %>

    <h2>Payment handles</h2>
    <p class="hint">Buyers see these at checkout so they can pay you directly. Fill in the ones you use.</p>

    <label for="cashapp">Cash App ($cashtag)</label>
    <input type="text" id="cashapp" name="cashapp" value="<%= user.cashapp || '' %>" placeholder="$yourtag">

    <label for="venmo">Venmo (@username)</label>
    <input type="text" id="venmo" name="venmo" value="<%= user.venmo || '' %>" placeholder="@your-venmo">

    <label for="paypal">PayPal (email or PayPal.Me link)</label>
    <input type="text" id="paypal" name="paypal" value="<%= user.paypal || '' %>" placeholder="you@email.com or paypal.me/you">

    <button class="btn" type="submit" style="width:100%; margin-top:16px;">Save changes</button>
  </form>

  <hr style="border:none;border-top:1px solid var(--line);margin:22px 0;">

  <h2>Change password</h2>
  <% if (passwordError) { %><div class="form-error"><%= passwordError %></div><% } %>
  <form action="/account/password" method="post">
    <label for="current_password">Current password</label>
    <input type="password" id="current_password" name="current_password" required>

    <label for="new_password">New password</label>
    <input type="password" id="new_password" name="new_password" required>
    <p class="hint">At least 6 characters.</p>

    <label for="confirm_password">Confirm new password</label>
    <input type="password" id="confirm_password" name="confirm_password" required>

    <button class="btn" type="submit" style="width:100%; margin-top:16px;">Update password</button>
  </form>

  <% if (user.role === 'buyer') { %>
    <hr style="border:none;border-top:1px solid var(--line);margin:22px 0;">
    <p>Want to sell too?</p>
    <form action="/become-seller" method="post">
      <button class="btn secondary" type="submit">Become a seller</button>
    </form>
  <% } %>
</div>
