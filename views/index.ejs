<h1>Browse listings</h1>
<p class="page-sub">Photos and items from independent creators.</p>

<form method="get" action="/" style="margin-top:14px;">
  <div class="row" style="max-width:520px;">
    <input type="text" name="q" value="<%= q %>" placeholder="Search listings…">
    <button class="btn secondary" type="submit" style="flex:0 0 auto;">Search</button>
  </div>
</form>

<div class="chips">
  <a class="chip <%= !category ? 'active' : '' %>" href="/?<%= lane && lane !== 'all' ? 'lane=' + lane + '&' : '' %><%= q ? 'q=' + encodeURIComponent(q) : '' %>">All</a>
  <% categories.forEach(function(c){ %>
    <a class="chip <%= category === c ? 'active' : '' %>" href="/?category=<%= c %><%= lane && lane !== 'all' ? '&lane=' + lane : '' %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"><%= categoryLabels[c] %></a>
  <% }); %>
</div>

<div class="chips" style="margin-top:8px;">
  <a class="chip <%= (!lane || lane === 'all') ? 'active' : '' %>" href="/?<%= category ? 'category=' + category + '&' : '' %><%= q ? 'q=' + encodeURIComponent(q) : '' %>">All content</a>
  <a class="chip <%= lane === 'sfw' ? 'active' : '' %>" href="/?lane=sfw<%= category ? '&category=' + category : '' %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">SFW</a>
  <a class="chip <%= lane === 'explicit' ? 'active' : '' %>" href="/?lane=explicit<%= category ? '&category=' + category : '' %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">🔞 Explicit</a>
</div>

<% if (products.length === 0) { %>
  <div class="empty">
    <p>No listings yet<%= q ? ' for “' + q + '”' : '' %>.</p>
    <% if (user && (user.role === 'seller' || user.role === 'admin')) { %>
      <a class="btn" href="/seller/new">Create the first listing</a>
    <% } %>
  </div>
<% } else { %>
  <div class="grid">
    <% products.forEach(function(p){ %>
      <a class="card" href="/product/<%= p.id %>">
        <div class="thumb" style="position:relative;<% if (p.thumb) { %>background-image:url('<%= p.thumb %>')<% } %>">
          <% if (!p.thumb) { %>No photo<% } %>
          <% if (p.blur_previews) { %>
            <span style="position:absolute;top:8px;right:8px;background:rgba(43,36,48,.82);color:#fff;padding:3px 9px;border-radius:999px;font-size:.72rem;font-weight:600;">🔒</span>
          <% } %>
          <% if (p.is_explicit) { %>
            <span style="position:absolute;top:8px;left:8px;background:#b91c1c;color:#fff;padding:3px 9px;border-radius:999px;font-size:.72rem;font-weight:700;">🔞 Explicit</span>
          <% } %>
        </div>
        <div class="body">
          <span class="tag"><%= categoryLabels[p.category] %></span>
          <span class="title"><%= p.title %></span>
          <span class="price"><%= money(p.price_cents) %></span>
          <span class="meta">by <%= p.seller_name %></span>
        </div>
      </a>
    <% }); %>
  </div>
<% } %>
