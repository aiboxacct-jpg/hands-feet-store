<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %> · <%= storeName %></title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a class="brand" href="/"><%= storeName %></a>
      <nav class="nav">
        <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Browse</a>
        <% if (user) { %>
          <% if (user.role === 'seller' || user.role === 'admin') { %>
            <a href="/seller" class="<%= currentPath.startsWith('/seller') ? 'active' : '' %>">Sell</a>
            <a href="/store/<%= user.id %>">My store</a>
          <% } %>
          <a href="/orders">My orders</a>
          <a href="/messages" class="<%= currentPath.startsWith('/messages') ? 'active' : '' %>">Messages</a>
          <% if (user.role === 'admin') { %>
            <a href="/admin" class="<%= currentPath.startsWith('/admin') ? 'active' : '' %>">Admin</a>
          <% } %>
          <a href="/account">Account</a>
          <form action="/logout" method="post" class="inline-form">
            <button class="btn ghost small" type="submit">Log out</button>
          </form>
        <% } else { %>
          <a href="/messages" class="<%= currentPath.startsWith('/messages') ? 'active' : '' %>">Messages</a>
          <a href="/login">Log in</a>
          <a href="/start-selling" class="btn small cta">Start selling</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="container">
    <% if (flash) { %>
      <div class="flash <%= flash.type %>"><%= flash.msg %></div>
    <% } %>
    <%- body %>
  </main>

  <footer class="site-footer">
    <div class="container">
      <%= storeName %> · Adults only (18+) · Be safe and follow your local laws.
      <div style="margin-top:6px;">
        <a href="/terms">Terms of Service</a> · <a href="/privacy">Privacy Policy</a>
      </div>
    </div>
  </footer>

  <script>
    // Copy-link buttons (used by the Share widgets).
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.share-copy');
      if (!btn) return;
      var url = btn.getAttribute('data-url');
      var done = function () {
        var original = btn.textContent;
        btn.textContent = '✓ Copied!';
        setTimeout(function () { btn.textContent = original; }, 1600);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(done, function () { window.prompt('Copy this link:', url); });
      } else {
        window.prompt('Copy this link:', url);
      }
    });
  </script>
</body>
</html>
