<% var storeUrl = absUrl('/store/' + seller.id); %>

<div style="margin-top:20px;">
  <h1 style="margin-bottom:2px;"><%= seller.display_name %></h1>
  <p class="muted" style="margin-top:0;"><%= products.length %> item<%= products.length === 1 ? '' : 's' %> for sale</p>
  <% if (seller.bio) { %><p style="white-space:pre-wrap;max-width:640px;"><%= seller.bio %></p><% } %>
</div>

<% if (user && user.id === seller.id) { %>
  <div class="share-box">
    <h2>📣 This is your public store — share it!</h2>
    <p class="muted" style="margin:0;">Post this link on Reddit, X, Telegram, or anywhere buyers hang out. Everything you list shows up here automatically.</p>
    <div class="share-link">
      <input type="text" readonly value="<%= storeUrl %>" onclick="this.select()">
      <button type="button" class="btn small share-copy" data-url="<%= storeUrl %>">🔗 Copy</button>
    </div>
    <%- include('partials/share', { shareUrl: storeUrl, shareTitle: seller.display_name + ' — shop my listings', label: 'Post to:' }) %>
  </div>
<% } else { %>
  <%- include('partials/share', { shareUrl: storeUrl, shareTitle: seller.display_name + ' — shop my listings', label: 'Share this store:' }) %>
<% } %>

<% if (products.length === 0) { %>
  <div class="empty"><p>No items listed yet.</p></div>
<% } else { %>
  <div class="grid">
    <% products.forEach(function(p){ %>
      <a class="card" href="/product/<%= p.id %>">
        <div class="thumb" style="position:relative;<% if (p.thumb) { %>background-image:url('<%= p.thumb %>')<% } %>">
          <% if (!p.thumb) { %>No photo<% } %>
          <% if (p.blur_previews) { %>
            <span style="position:absolute;top:8px;right:8px;background:rgba(43,36,48,.82);color:#fff;padding:3px 9px;border-radius:999px;font-size:.72rem;font-weight:600;">🔒</span>
          <% } %>
        </div>
        <div class="body">
          <span class="tag"><%= categoryLabels[p.category] %></span>
          <span class="title"><%= p.title %></span>
          <span class="price"><%= money(p.price_cents) %></span>
        </div>
      </a>
    <% }); %>
  </div>
<% } %>

<div id="chat" class="chat-box">
  <h2 style="margin-top:0;">💬 Message <%= seller.display_name %></h2>
  <% if (isOwner) { %>
    <p class="muted">This is your store. When buyers message you here, you'll see and reply to them in your <a href="/messages">Messages inbox</a>.</p>
  <% } else { %>
    <% if (messages.length) { %>
      <div class="chat-thread">
        <% messages.forEach(function(m){ %>
          <div class="msg <%= m.sender === 'buyer' ? 'mine' : 'them' %>">
            <span class="who"><%= m.sender === 'seller' ? seller.display_name : 'You' %></span>
            <p><%= m.body %></p>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p class="muted">Have a question? Send <%= seller.display_name %> a message — no account needed.</p>
    <% } %>
    <form action="/messages/start" method="post" class="chat-form">
      <input type="hidden" name="seller_id" value="<%= seller.id %>">
      <% if (!user && !conv) { %>
        <input type="text" name="name" maxlength="60" placeholder="Your name (optional)">
      <% } %>
      <textarea name="body" rows="2" maxlength="2000" placeholder="Write a message…" required></textarea>
      <button class="btn" type="submit">Send</button>
    </form>
    <% if (conv && !user) { %>
      <p class="hint">💡 Reopen this store page anytime to see replies, or bookmark your <a href="/messages/<%= conv.id %>?t=<%= conv.access_token %>">private chat link</a>.</p>
    <% } %>
  <% } %>
</div>

<p style="margin-top:24px;"><a href="/" class="muted">← Browse all listings</a></p>
