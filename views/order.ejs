<div class="form-card">
  <h1>Order #<%= order.id %></h1>
  <p class="page-sub"><span class="badge <%= order.status %>"><%= order.status %></span></p>

  <table style="box-shadow:none;">
    <tr><th>Item</th><td><%= order.title %></td></tr>
    <tr><th>Amount</th><td><%= money(order.amount_cents) %></td></tr>
    <tr><th>Seller</th><td><%= order.seller_name %></td></tr>
    <tr><th>Buyer</th><td><%= order.buyer_name %></td></tr>
    <tr><th>Payment</th><td><%= order.payment_method %><% if (handle) { %> → <code><%= handle %></code><% } %></td></tr>
    <tr><th>Placed</th><td><%= order.created_at %> UTC</td></tr>
  </table>

  <% if (order.status === 'pending' && isBuyer) { %>
    <div style="background:#fff3dc;border-radius:10px;padding:14px;margin-top:16px;">
      <strong>Next step:</strong> Send <strong><%= money(order.amount_cents) %></strong>
      via <strong><%= order.payment_method %></strong><% if (handle) { %> to <code><%= handle %></code><% } %>.
      Once the seller confirms your payment, your order moves to <em>paid</em>.
    </div>
    <% if (!user) { %>
      <p class="hint" style="margin-top:10px;">💡 Bookmark this page to check your order status later — it's your private link. Or <a href="/register">create an account</a> to track all your orders.</p>
    <% } %>
  <% } %>

  <% if (deliverables.length > 0) { %>
    <h2>Your download<%= deliverables.length > 1 ? 's' : '' %></h2>
    <% if (unlocked && (isBuyer || isSeller)) { %>
      <div style="background:#e5f6ec;border-radius:10px;padding:14px;margin-top:8px;">
        <p style="margin:0 0 10px;"><strong>✓ Unlocked</strong> — your file<%= deliverables.length > 1 ? 's are' : ' is' %> ready.</p>
        <% deliverables.forEach(function(d){ %>
          <a class="btn small" style="margin:4px 4px 0 0;" href="/orders/<%= order.id %>/download/<%= d.id %><%= downloadSuffix %>">⬇ <%= d.original_name %></a>
        <% }); %>
      </div>
    <% } else if (isBuyer) { %>
      <div style="background:#fff3dc;border-radius:10px;padding:14px;margin-top:8px;">
        🔒 This order includes <strong><%= deliverables.length %></strong> file<%= deliverables.length > 1 ? 's' : '' %> to download.
        <strong>They unlock automatically once the seller confirms your payment.</strong>
      </div>
    <% } else if (isSeller) { %>
      <p class="muted">This listing has <strong><%= deliverables.length %></strong> delivery file<%= deliverables.length > 1 ? 's' : '' %>. The buyer can download <%= deliverables.length > 1 ? 'them' : 'it' %> as soon as you mark this order <strong>paid</strong>.</p>
    <% } %>
  <% } %>

  <% if (isSeller) { %>
    <h2>Seller actions</h2>
    <% if (order.contact) { %><p><strong>Buyer contact:</strong> <%= order.contact %></p><% } %>
    <% if (order.note) { %><p><strong>Note:</strong> <%= order.note %></p><% } %>
    <form action="/seller/orders/<%= order.id %>/status" method="post" class="row" style="align-items:flex-end;">
      <div>
        <label>Update status</label>
        <select name="status">
          <% ['pending','paid','shipped','cancelled'].forEach(function(s){ %>
            <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s %></option>
          <% }); %>
        </select>
      </div>
      <button class="btn" type="submit" style="flex:0 0 auto;">Save</button>
    </form>
  <% } %>

  <p style="margin-top:18px;">
    <% if (user) { %><a href="/orders" class="muted">← My orders</a>
    <% } else { %><a href="/" class="muted">← Continue shopping</a><% } %>
  </p>
</div>
