<h1>Chat monitor</h1>
<div class="chips">
  <a class="chip" href="/admin">Overview</a>
  <a class="chip" href="/admin/users">Users</a>
  <a class="chip" href="/admin/listings">Listings</a>
  <a class="chip" href="/admin/orders">Orders</a>
  <a class="chip active" href="/admin/lounge">Chat</a>
</div>

<p class="muted">The global Lounge — newest first. This page auto-refreshes every 20s. You can also
  <a href="/lounge" target="_blank" rel="noopener">open the live Lounge ↗</a> to chat (your ⭐ badge shows there).</p>

<% if (messages.length === 0) { %>
  <p class="muted">No chat messages yet.</p>
<% } else { %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Time (UTC)</th><th>Name</th><th>Role</th><th>Message</th><th></th></tr></thead>
      <tbody>
        <% messages.forEach(function(m){ %>
          <tr>
            <td class="muted" style="white-space:nowrap;font-size:.85rem;"><%= (m.created_at || '').slice(0,16) %></td>
            <td><%= m.name %></td>
            <td>
              <% if (m.role === 'admin') { %>⭐ admin<% } else if (m.role) { %><%= m.role %><% } else { %><span class="muted">guest</span><% } %>
            </td>
            <td style="overflow-wrap:anywhere;"><%= m.body %></td>
            <td>
              <form action="/admin/lounge/<%= m.id %>/delete" method="post" class="inline-form"
                    onsubmit="return confirm('Delete this message?');">
                <button class="btn small danger" type="submit">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<script>setTimeout(function () { location.reload(); }, 20000);</script>
