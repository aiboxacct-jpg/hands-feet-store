# Copy to ".env" for local prod-like testing, or set these in Render's dashboard.
# Leave DATABASE_URL and CLOUDINARY_URL BLANK to run fully locally
# (uses built-in SQLite file + the local ./uploads folder).

# --- Database (Turso) ---
# Create a free DB at https://turso.tech, then:
#   turso db show <name> --url        -> DATABASE_URL
#   turso db tokens create <name>     -> DATABASE_AUTH_TOKEN
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Image hosting (Cloudinary) ---
# From your Cloudinary dashboard "API Environment variable":
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# --- App ---
STORE_NAME=My Store
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@store.local
ADMIN_PASSWORD=change-this
# PORT=3000
